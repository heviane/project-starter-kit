# EditorConfig: https://EditorConfig.org
root = true

# Padrões globais para todos os arquivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python (PEP 8)
[*.py]
indent_style = space
indent_size = 4

# JavaScript, TypeScript e ecossistema Web
[*.{js,jsx,ts,tsx,vue,svelte}]
indent_style = space
indent_size = 2

# Formatos de dados estruturados e configuração
[*.{json,json5,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Documentação Markdown (preserva trailing spaces para quebras de linha BDD/Gherkin)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Java, C# e C/C++
[*.{java,cs,c,cpp,h,hpp}]
indent_style = space
indent_size = 4

# Makefiles e scripts com tabs obrigatórias
[Makefile]
indent_style = tab
