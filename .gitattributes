# ==============================================================================
# NORMALIZAÇÃO CANÔNICA DE QUEBRAS DE LINHA (GITATTRIBUTES)
# ==============================================================================

# Padrão universal: arquivos de texto normalizados com terminação LF
* text=auto eol=lf

# Código-fonte, configurações e documentação (sempre LF)
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.mdc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.py text eol=lf
*.cs text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.sql text eol=lf
*.env* text eol=lf

# Scripts para ambientes Unix / macOS (sempre LF)
*.sh text eol=lf

# Scripts para ambientes Windows (mantêm CRLF para compatibilidade)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Arquivos binários preservados sem conversão
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.jar binary
*.war binary
